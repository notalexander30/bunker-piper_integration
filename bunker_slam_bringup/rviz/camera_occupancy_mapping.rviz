Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Metric Grid
      Plane: XY
    - Alpha: 1
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: RTAB-Map Navigation Occupancy Grid
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Update Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map_updates
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Keep: 200
      Name: Visual Odometry (diagnostic)
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /visual_odom
    - Class: rviz_default_plugins/TF
      Enabled: false
      Name: TF (diagnostic)
      Show Arrows: false
      Show Axes: false
      Show Names: false
  Enabled: true
  Global Options:
    Background Color: 238; 238; 238
    Fixed Frame: map
    Frame Rate: 10
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Name: Navigation Map
      Scale: 50
      Target Frame: map
      X: 0
      Y: 0
      Value: TopDownOrtho (rviz)
Window Geometry:
  Height: 900
  Width: 1100
