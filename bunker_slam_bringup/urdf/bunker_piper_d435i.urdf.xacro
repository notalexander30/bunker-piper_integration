<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bunker_piper_d435i">
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>
  <!--
    The stock PiPER model is a stand-alone world -> base_link robot and cannot
    be combined with the mobile base without duplicate base_link ownership.
    This model preserves its six discovered joint origins under arm_base and
    attaches the D435i camera_link to the flange in the same TF tree.

    The default arm mount is the kinematic closure implied by the repository's
    locked-pose calibration:
      joint1..6 = [-1.6, 0, 0, 0, 0, 0]
      base_link -> camera_link = [0.60, 0.00, 0.62], RPY [0, 0, 0]
      flange_link -> camera_link = identity (the D435i tripod-mount offset is
      canceled by the default camera_mount_xyz below)
    It is the best existing calibration, not an independently surveyed mount.
    Do not move the arm during initial mapping; replace these arguments after
    measuring base_link -> arm_base and flange_link -> camera_link separately.
  -->
  <xacro:arg name="arm_mount_xyz" default="0.807474630 0.0 0.545498689"/>
  <xacro:arg name="arm_mount_rpy" default="-1.483492816 0.029092513 1.573342313"/>
  <xacro:arg name="camera_mount_xyz" default="-0.0106 -0.0175 -0.0125"/>
  <xacro:arg name="camera_mount_rpy" default="0.0 0.0 0.0"/>

  <material name="bunker_gray"><color rgba="0.25 0.25 0.25 1.0"/></material>
  <material name="bunker_white"><color rgba="0.82 0.84 0.86 1.0"/></material>

  <link name="base_link">
    <visual>
      <!-- Detailed Bunker Mini CAD visual. The base_link frame remains on the
           ground plane, matching the existing EKF and navigation contract. -->
      <origin xyz="0 0 0.274197" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://bunker_dual_piper_nav2/meshes/bunker/base_link.STL"/>
      </geometry>
      <material name="bunker_white"/>
    </visual>
    <!-- Keep navigation collision simple and independent of the CAD mesh. -->
    <collision>
      <origin xyz="0.013088 0 0.165358" rpy="0 0 0"/>
      <geometry><box size="0.692884 0.564000 0.330715"/></geometry>
    </collision>
  </link>

  <link name="arm_base">
    <visual>
      <geometry>
        <mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/base_link.dae"/>
      </geometry>
    </visual>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base"/>
    <origin xyz="$(arg arm_mount_xyz)" rpy="$(arg arm_mount_rpy)"/>
  </joint>

  <link name="arm_link1">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link1.dae"/></geometry></visual>
  </link>
  <joint name="joint1" type="revolute">
    <parent link="arm_base"/><child link="arm_link1"/>
    <origin xyz="0 0 0.123" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.6179938" upper="2.6179938" effort="100" velocity="5"/>
  </joint>

  <link name="arm_link2">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link2.dae"/></geometry></visual>
  </link>
  <joint name="joint2" type="revolute">
    <parent link="arm_link1"/><child link="arm_link2"/>
    <origin xyz="0 0 0" rpy="1.5707963 -0.1357866 -3.1415926"/><axis xyz="0 0 1"/>
    <limit lower="0" upper="3.1415926" effort="100" velocity="5"/>
  </joint>

  <link name="arm_link3">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link3.dae"/></geometry></visual>
  </link>
  <joint name="joint3" type="revolute">
    <parent link="arm_link2"/><child link="arm_link3"/>
    <origin xyz="0.28503 0 0" rpy="0 0 -1.7938494"/><axis xyz="0 0 1"/>
    <limit lower="-2.9670597" upper="0" effort="100" velocity="5"/>
  </joint>

  <link name="arm_link4">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link4.dae"/></geometry></visual>
  </link>
  <joint name="joint4" type="revolute">
    <parent link="arm_link3"/><child link="arm_link4"/>
    <origin xyz="-0.02198 -0.25075 0" rpy="1.5707963 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="100" velocity="5"/>
  </joint>

  <link name="arm_link5">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link5.dae"/></geometry></visual>
  </link>
  <joint name="joint5" type="revolute">
    <parent link="arm_link4"/><child link="arm_link5"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-1.2217304" upper="1.2217304" effort="100" velocity="5"/>
  </joint>

  <link name="arm_link6">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/link6.dae"/></geometry></visual>
  </link>
  <joint name="joint6" type="revolute">
    <parent link="arm_link5"/><child link="arm_link6"/>
    <origin xyz="0.000088259 -0.091 0" rpy="1.5707963 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-2.0943951" upper="2.0943951" effort="100" velocity="5"/>
  </joint>

  <link name="flange_link">
    <visual><geometry><mesh filename="package://agx_arm_description/agx_arm_urdf/piper/meshes/dae/flange.dae"/></geometry></visual>
  </link>
  <joint name="flange_joint" type="fixed">
    <parent link="arm_link6"/><child link="flange_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- RSP owns the physical flange -> camera_link mount and camera visual.
       use_nominal_extrinsics=false leaves calibrated internal camera frames to
       the RealSense driver, avoiding duplicate color/depth/IMU transforms. -->
  <xacro:sensor_d435i parent="flange_link" name="camera" use_nominal_extrinsics="false">
    <origin xyz="$(arg camera_mount_xyz)" rpy="$(arg camera_mount_rpy)"/>
  </xacro:sensor_d435i>
</robot>
