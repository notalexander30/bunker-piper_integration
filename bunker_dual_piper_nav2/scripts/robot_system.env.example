# Copy this file to robot_system.env and edit the values on the Jetson.

# The workspace that contains this package and the robot drivers.
ROS_DISTRO=humble
ROBOT_WS=/home/dase-orin/ros2_ws

# Hardware startup. Leave START_HARDWARE_DRIVERS=0 until both CAN names are
# confirmed with: ip -brief link | grep can
START_HARDWARE_DRIVERS=0
START_BUNKER_DRIVER=1
START_PIPER_DRIVERS=1
# SocketCAN assignment. Discover these first; do not assume canN order.
# See docs/can_discovery.md in the repository root.
FRONT_PIPER_CAN=canX
REAR_PIPER_CAN=canY
BUNKER_CAN=canZ

# Camera startup. A serial is required when both D435i units are connected.
START_CAMERAS=1
START_FRONT_CAMERA=1
START_REAR_CAMERA=1
FRONT_CAMERA_SERIAL=
REAR_CAMERA_SERIAL=

# If your RTAB-Map launch is already running, leave START_RTABMAP=0.
# Otherwise provide the absolute path to your existing RTAB-Map launch file.
START_RTABMAP=0
RTABMAP_LAUNCH_FILE=

# Optional: launch your existing YOLO ROS 2 launch file in the same process.
START_YOLO=0
YOLO_LAUNCH_FILE=

# Namespaced AGX PiPER feedback consumed by the combined URDF state publisher.
FRONT_JOINT_STATES_TOPIC=/front_piper/feedback/joint_states
REAR_JOINT_STATES_TOPIC=/rear_piper/feedback/joint_states

# Camera transform estimates, in metres/radians relative to each gripper_base.
# Calibrate these in RViz before using camera points for close obstacle avoidance.
FRONT_CAMERA_XYZ="-0.030 0.000 0.070"
FRONT_CAMERA_RPY="-0.08017405150425999 -0.0031709794581423934 0.023976595541682157"
REAR_CAMERA_XYZ="-0.0016016943280790555 -0.07988793520475261 0.0420998734823866"
REAR_CAMERA_RPY="-0.0041241555313950035 -0.003886773443390706 0.0554203109827187"

# Set to 1 only if firmware is older than S-V1.6-3.
FRONT_PIPER_LEGACY=0
REAR_PIPER_LEGACY=0

# Defaults: front 180 degrees yaw, rear -90 degrees yaw.
# Change only after comparing base axes and the physical cable side in RViz.
FRONT_PIPER_MOUNT_RPY="0 0 1.57079632679"
REAR_PIPER_MOUNT_RPY="0 0 1.57079632679"
