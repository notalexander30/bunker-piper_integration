Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.85
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: RTAB-Map occupancy
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /map
    - Alpha: 1
      Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: TF-projected Bunker + dual PiPER
      Update Interval: 0
      Visual Enabled: true
    - Alpha: 1
      Class: rviz_default_plugins/Polygon
      Color: 255; 215; 0
      Enabled: true
      Name: Nav2 collision footprint
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_costmap/published_footprint
    - Alpha: 0.55
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Global costmap (optional)
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /global_costmap/costmap
    - Alpha: 0.35
      Class: rviz_default_plugins/Map
      Color Scheme: costmap
      Draw Behind: true
      Enabled: false
      Name: Local rolling costmap (optional)
      Topic:
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /local_costmap/costmap
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 255; 0
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Line Style: Lines
      Line Width: 0.03
      Name: Global plan
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /plan
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 165; 0
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.15
      Line Style: Lines
      Line Width: 0.025
      Name: Local controller trajectory
      Topic:
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Value: /local_plan
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.12
      Name: TF diagnostic
      Show Axes: true
      Show Names: false
    - Alpha: 0.6
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Enabled: false
      Name: Front D435i cloud (optional)
      Position Transformer: XYZ
      Size (Pixels): 2
      Style: Points
      Topic:
        Reliability Policy: Best Effort
        Value: /front_camera/depth/color/points
  Enabled: true
  Global Options:
    Background Color: 238; 238; 238
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: TF-accurate 2D projection
      Near Clip Distance: 0.01
      Scale: 60
      Target Frame: base_link
      X: 0
      Y: 0
Window Geometry:
  Height: 900
  Width: 1440

